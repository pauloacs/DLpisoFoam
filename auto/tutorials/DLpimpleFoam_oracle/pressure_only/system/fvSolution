FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    p
    {
        solver GAMG;
        tolerance 1e-6;
        relTol 0;
        smoother GaussSeidel;
    }
    pFinal { $p; }
    U
    {
        solver smoothSolver;
        smoother GaussSeidel;
        tolerance 1e-6;
        relTol 0;
        nSweeps 1;
    }
    UFinal { $U; }
    k { $U; }
    kFinal { $U; }
    omega { $U; }
    omegaFinal { $U; }
}
PIMPLE
{
    nNonOrthogonalCorrectors 0;
    nCorrectors 1;
    nOuterCorrectors 15;
    residualControl { U 5e-4; p 5e-4; }
    outerCorrectorResidualControl
    {
        U { tolerance 5e-4; relTol 0; }
        p { tolerance 5e-4; relTol 0; }
    }
}
relaxationFactors
{
    fields { p 0.6; pFinal 0.6; }
    equations { U 0.8; UFinal 0.8; k 0.8; kFinal 0.8; omega 0.8; omegaFinal 0.8; }
}