#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

solver="${SOLVER:-DLpimpleFoam_auto}"
for program in blockMesh checkMesh python3 "$solver"; do
    command -v "$program" >/dev/null || { echo "Missing command: $program" >&2; exit 1; }
done
if [[ -d constant/polyMesh || -d ML_data || -f log.solver ]]; then
    echo 'Existing generated files found. Run bash Allclean before restarting.' >&2
    exit 1
fi
python3 -c 'import tensorflow, h5py, mpi4py; import pressure_SM_mesh_graph._3D.graph_io'

run_logged()
{
    local logfile="$1"
    shift
    "$@" > "$logfile" 2>&1 || { tail -n 60 "$logfile" >&2; return 1; }
}

run_logged log.blockMesh blockMesh
run_logged log.checkMesh checkMesh -allGeometry -allTopology
run_logged log.solver "$solver"
echo 'Finished. See log.solver and ML_data/training_plots/ddp/baseline_summary.json.'